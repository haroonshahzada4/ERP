NODE_ENV=development
PORT=8000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:8001

MASTER_DB_ENABLED=true
MASTER_DB_HOST=127.0.0.1
MASTER_DB_PORT=5432
MASTER_DB_USER=erp
MASTER_DB_PASSWORD=admin
MASTER_DB_NAME=erp_master

PG_SUPERUSER=postgres
PG_SUPERUSER_PASSWORD=admin

DEMO_TENANT_SLUG=demo
DEMO_TENANT_DB_NAME=erp_tenant_demo
DEMO_ADMIN_EMAIL=admin@demo.com
DEMO_ADMIN_PASSWORD=admin

TYPEORM_SYNC=false
TYPEORM_LOGGING=true
TYPEORM_RUN_MIGRATIONS=true

REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379

JWT_ACCESS_SECRET=erp-local-access-secret-admin
JWT_REFRESH_SECRET=erp-local-refresh-secret-admin
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
